generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Auditoria {
  id        String   @id @default(cuid())
  evento    String
  autor     String?
  entidad   String?
  detalle   Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@map("auditoria")
}
